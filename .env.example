# Local Vite proxy → Laravel (only when VITE_API_URL is empty)
VITE_API_PROXY=http://127.0.0.1:8000

# API origin for the SPA (no trailing slash).
# Empty = same-origin / Vite proxy to VITE_API_PROXY.
#
# Local without `php artisan serve`:
#   VITE_API_URL=https://enot-api.qpanel-erp.online
# Local with artisan on :8000:
#   VITE_API_URL=
#   VITE_API_PROXY=http://127.0.0.1:8000
#
# TEST build:  https://enot-api.qpanel-erp.online  (see .env.production)
# PROD:        https://enot-24.com.ua
VITE_API_URL=
