APP_NAME=ЄНОТ-24
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# ─── URLs (change for PROD) ───────────────────────────────────
# TEST API:  https://enot-api.qpanel-erp.online
# PROD API:  https://enot-24.com.ua   ← or your prod API host
APP_URL=https://enot-api.qpanel-erp.online

# TEST SPA:  https://enot.qpanel-erp.online
# PROD SPA:  https://enot-24.com.ua   ← change when going live
FRONTEND_URL=https://enot.qpanel-erp.online

# Canonical site URL for SEO (usually the frontend)
SEO_SITE_URL=https://enot.qpanel-erp.online

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=enot24
DB_USERNAME=root
DB_PASSWORD=

# Telegram (optional)
TG_BOT_TOKEN=
TG_CHAT_ID=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync

# ─── Cross-origin SPA (frontend on another subdomain) ─────────
# TEST: keep .qpanel-erp.online + SameSite=none
# PROD (same site for SPA+API): SESSION_DOMAIN=null, SESSION_SAME_SITE=lax
#
# CSRF: SPA calls GET /sanctum/csrf-cookie then GET /api/csrf-token and sends
# X-CSRF-TOKEN. Parent SESSION_DOMAIN is still required so the session cookie
# is stored/sent across subdomains (enot.* ↔ enot-api.*).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=.qpanel-erp.online
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

# Comma-separated. Must include the SPA origin (scheme + host [+ port]).
CORS_ALLOWED_ORIGINS=https://enot.qpanel-erp.online,http://127.0.0.1:5173,http://localhost:5173

# Hosts allowed for Sanctum stateful cookies (no protocol). Include SPA host + port for Vite.
SANCTUM_STATEFUL_DOMAINS=enot.qpanel-erp.online,localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
