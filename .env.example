APP_NAME=ЄНОТ-24
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# ─── URLs (change for PROD) ───────────────────────────────────
# TEST API:  https://enot-api.qpanel-erp.online
# PROD API:  https://enot-24.com.ua   ← or your prod API host
APP_URL=https://enot-api.qpanel-erp.online

# TEST SPA:  https://enot.qpanel-erp.online
# PROD SPA:  https://enot-24.com.ua   ← change when going live
FRONTEND_URL=https://enot.qpanel-erp.online

# Canonical site URL for SEO (usually the frontend)
SEO_SITE_URL=https://enot.qpanel-erp.online

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=enot24
DB_USERNAME=root
DB_PASSWORD=

# Telegram (optional)
TG_BOT_TOKEN=
TG_CHAT_ID=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync

# ─── Cross-origin SPA (REQUIRED when frontend ≠ API host) ─────
#
# Live setup:
#   SPA:  https://enot-24.com.ua
#   API:  https://enot-api.qpanel-erp.online
#
# Browser will REJECT XSRF-TOKEN / *_session cookies with:
#   "SameSite=Lax was rejected in a cross-site context"
# unless cookies are set as SameSite=None; Secure.
#
# After changing these on the server, run:
#   php artisan config:clear && php artisan cache:clear
#
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Cookie Domain for the API host tree (API is *.qpanel-erp.online)
SESSION_DOMAIN=.qpanel-erp.online
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
# Force cross-site cookie flags in code even if an old config:cache has lax
SESSION_FORCE_CROSS_SITE=true

FRONTEND_URL=https://enot-24.com.ua

# Must list every SPA origin that calls the API (scheme + host)
CORS_ALLOWED_ORIGINS=https://enot-24.com.ua,https://www.enot-24.com.ua,https://enot.qpanel-erp.online,http://127.0.0.1:5173,http://localhost:5173

# Sanctum stateful hosts — NO protocol. Include SPA hosts.
SANCTUM_STATEFUL_DOMAINS=enot-24.com.ua,www.enot-24.com.ua,enot.qpanel-erp.online,enot-api.qpanel-erp.online,localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
